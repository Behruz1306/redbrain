# Required: ZeroEntropy API for embeddings & reranking
ZEROENTROPY_API_KEY=ze-...

# Optional: Claude API for LLM-powered correlation & reports
# Without this, system uses heuristic-only mode (still fully functional)
ANTHROPIC_API_KEY=sk-ant-...

# Frontend: set to deployed backend host (without protocol)
# Leave empty for local dev (defaults to localhost:8000)
NEXT_PUBLIC_API_HOST=
